# OAuth2: Client Credentials Grant
# Machine-to-machine authentication (no user interaction)
# Token is acquired automatically and injected as: Authorization: Bearer <token>

@baseUrl = https://api.example.com
@oauth2-cache = .tokens.json

###

### Client Credentials: API access (machine-to-machine)
# The token is automatically acquired from the OAuth2 provider and cached
# Replace CLIENT_ID and CLIENT_SECRET with your actual credentials
# Or use environment variables: {{$env CLIENT_ID}}, {{$env CLIENT_SECRET}}

# @oauth2-grant = client_credentials
# @oauth2-token-url = https://auth.example.com/oauth/token
# @oauth2-client-id = {{CLIENT_ID}}
# @oauth2-client-secret = {{CLIENT_SECRET}}
# @oauth2-scope = read write
GET {{baseUrl}}/resource

###

### Using environment variables for credentials
# Set these in your system environment or .env file:
#   CLIENT_ID=your-client-id
#   CLIENT_SECRET=your-client-secret

# @oauth2-grant = client_credentials
# @oauth2-token-url = https://auth.example.com/oauth/token
# @oauth2-client-id = {{$env CLIENT_ID}}
# @oauth2-client-secret = {{$env CLIENT_SECRET}}
# @oauth2-scope = api
GET {{baseUrl}}/protected

###

### POST with OAuth2
# @oauth2-grant = client_credentials
# @oauth2-token-url = https://auth.example.com/oauth/token
# @oauth2-client-id = client-id-here
# @oauth2-client-secret = client-secret-here
# @oauth2-scope = read write delete
POST {{baseUrl}}/resource
Content-Type: application/json

{
  "name": "New Resource",
  "description": "Created with OAuth2"
}

###

### Token caching
# Tokens are cached in .tokens.json (or file specified by @oauth2-cache)
# Cache key is: grant::tokenURL::clientID::scope
# Tokens are reused until they expire (cache checks expiry with 30s buffer)
# You don't need to do anything—it's automatic!

# @oauth2-grant = client_credentials
# @oauth2-token-url = https://auth.example.com/oauth/token
# @oauth2-client-id = my-client
# @oauth2-client-secret = my-secret
# @oauth2-scope = read
GET {{baseUrl}}/data/1

###

# This request reuses the token from above (same grant, tokenURL, clientID, scope)
# @oauth2-grant = client_credentials
# @oauth2-token-url = https://auth.example.com/oauth/token
# @oauth2-client-id = my-client
# @oauth2-client-secret = my-secret
# @oauth2-scope = read
GET {{baseUrl}}/data/2

###

### Different scope = different token
# Same token URL and client, but different scope = separate cache entry

# @oauth2-grant = client_credentials
# @oauth2-token-url = https://auth.example.com/oauth/token
# @oauth2-client-id = my-client
# @oauth2-client-secret = my-secret
# @oauth2-scope = read write
POST {{baseUrl}}/data
Content-Type: application/json

{"name": "test"}

###

### File-level token cache
# Set @oauth2-cache once at the top of the file to use a custom cache file
# If not set, defaults to .tokens.json in workspace root

# @oauth2-cache = .custom-tokens.json
#
# Then all requests in this file use .custom-tokens.json for token storage
